# Copy to .env and fill in. Restart `npm run dev` after changes.

# Origin you open in the browser. OAuth redirect URIs are `${APP_URL}/api/auth/<platform>/callback`
APP_URL=http://localhost:3000

# X (Twitter) — developer.x.com → your app → User authentication settings (OAuth 2.0)
#   Callback URL: http://localhost:3000/api/auth/twitter/callback
#   Scopes: tweet.read tweet.write users.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — linkedin.com/developers → your app → Auth
#   Redirect URL: http://localhost:3000/api/auth/linkedin/callback
#   Products to add: "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Extra permissions for LinkedIn's consent screen. ONLY add scopes LinkedIn has approved your app for;
# an unapproved scope makes LinkedIn reject the whole sign-in. Space separated. See README for what each does.
# LINKEDIN_SCOPES_PROFILE=r_member_social
# LINKEDIN_SCOPES_PAGE=r_organization_social rw_organization_admin

# Optional
# TRUST_PROXY=1            # number of reverse proxies in front of the server; needed for correct login rate limiting behind one
# MAX_MEDIA_MB=2048        # total media library size cap
# TOKEN_ENCRYPTION_KEY=<64 hex chars; generated into server/data/.key if unset>
# LINKEDIN_API_VERSION=202601

# Facebook + Instagram — developers.facebook.com → create a Business app → add "Facebook Login"
#   Valid OAuth redirect URIs: http://localhost:3000/api/auth/facebook/callback
#                              http://localhost:3000/api/auth/instagram/callback
META_APP_ID=
META_APP_SECRET=
# Instagram downloads images from this public https address (e.g. an ngrok URL that forwards to this server)
# PUBLIC_URL=https://your-tunnel.example.com
# META_GRAPH_VERSION=v23.0

# TikTok — developers.tiktok.com → Content Posting API. Redirect URI must be https.
#   http://localhost:3000/api/auth/tiktok/callback (use a tunnel; set APP_URL to it)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_PRIVACY=PUBLIC_TO_EVERYONE   # only after TikTok audits your app; default posts are private

# Pinterest — developers.pinterest.com → your app
#   Redirect URI: http://localhost:3000/api/auth/pinterest/callback
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# PINTEREST_API_BASE=https://api-sandbox.pinterest.com/v5   # for trial-access apps
